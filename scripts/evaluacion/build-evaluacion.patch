+/// Build de evaluación: los diálogos nativos no se muestran. La respuesta se
+/// lee de `%LOCALAPPDATA%\eval-dialogo.txt` (ruta, o vacío para cancelar).
+trait EvalPick { fn eval_pick(self) -> Option<std::path::PathBuf>; }
+impl EvalPick for FileDialog {
+    fn eval_pick(self) -> Option<std::path::PathBuf> {
+        let base = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from)?;
+        let answer = base.join("eval-dialogo.txt");
+        let text = std::fs::read_to_string(&answer).ok();
+        let _ = std::fs::remove_file(&answer);
+        let line = text?.trim().to_string();
+        (!line.is_empty()).then(|| std::path::PathBuf::from(line))
+    }
+}
